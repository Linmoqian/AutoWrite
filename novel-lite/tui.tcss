/* Novel-Lite TUI Dashboard 样式 */

Screen {
    layout: vertical;
}

/* 侧边栏：左侧停靠，固定宽度 */
#sidebar {
    dock: left;
    width: 28;
    height: 1fr;
    background: $surface-darken-1;
    border-right: solid $primary;
    padding: 1 0;
}

#sidebar-header {
    text-align: center;
    text-style: bold;
    color: $text;
    padding: 0 1;
    height: 3;
    content-align: center middle;
}

#novel-list {
    height: 1fr;
}

.listitem-label {
    padding: 0 1;
    height: auto;
}

/* 主区域 */
#main-area {
    layout: vertical;
    height: 1fr;
    padding: 1 2;
}

/* 书籍信息面板 */
#book-info {
    height: auto;
    background: $surface;
    border: solid $primary-lighten-1;
    padding: 1 2;
    margin-bottom: 1;
}

/* 进度条区域 */
#progress-section {
    height: auto;
    margin-bottom: 1;
}

ProgressBar {
    width: 1fr;
    height: 1;
}

#progress-label {
    height: 1;
    color: $text-muted;
    text-align: right;
}

/* 统计行 */
#stats-row {
    height: auto;
    layout: horizontal;
    margin-bottom: 1;
    padding: 0 1;
}

.stat-item {
    color: $text-muted;
    margin-right: 2;
}

/* 按钮行 */
#button-row {
    height: auto;
    layout: horizontal;
    padding: 0;
    margin-bottom: 1;
    align: center middle;
    width: 1fr;
}

#button-row Button {
    margin-right: 1;
    min-width: 14;
}

/* 创作日志 */
#log-area {
    height: 1fr;
    background: $surface-darken-2;
    border: solid $primary-lighten-1;
    padding: 0;
    scrollbar-size: 1 1;
}

RichLog {
    height: 1fr;
    padding: 0 1;
}

/* 底部状态栏 */
#status-bar {
    dock: bottom;
    height: 1;
    background: $primary;
    color: $text;
    padding: 0 2;
    layout: horizontal;
}

#status-model {
    width: auto;
}

#status-elapsed {
    width: auto;
}

#status-session {
    width: auto;
}

/* 空状态提示 */
#empty-hint {
    height: 1fr;
    padding: 2 4;
    text-align: center;
    content-align: center middle;
    color: $text-muted;
    text-style: italic;
}
